rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper: Is the user an admin?
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || 
        exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email))
      );
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !getUserData().isMuted && !getUserData().isBanned;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        isAdmin()
      );
      allow delete: if isAdmin(); // We prefer soft-delete, but admin can hard-delete
    }

    // Typing Collection
    match /typing/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Seal 'approved' status: users cannot change their status away from 'approved' once set.
      // This prevents buggy presence logic from overwriting the approval status.
      allow write: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && (
          resource == null || 
          resource.data.get('status', '') != 'approved' || 
          request.resource.data.get('status', '') == 'approved'
        ))
      );
    }

    // Admin Emails (Read-only for admins)
    match /admin_emails/{email} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Livestream Comments ───────────────────────────────────────────────
    match /livestream_comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200;
      allow update, delete: if false; // comments are immutable
    }

    // ── Livestream Likes (one doc per user UID) ───────────────────────────
    match /livestream_likes/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if false; // likes are permanent
    }

    // ── Livestream Meta (aggregated like count) ───────────────────────────
    match /livestream_meta/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Default: Allow all other collections for a limited time (as per existing rules)
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 6, 15);
    }
  }
}
